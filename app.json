{
  "expo": {
    "name": "트립나우",
    "slug": "tripnow",
    "version": "0.1.0",
    "platforms": ["android"],
    "orientation": "portrait",
    "scheme": "tripnow",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TripNow는 일본 도착 여부를 단말 내부에서 확인하기 위해 현재 위치를 사용합니다. 위치 좌표는 TripNow 서버에 전송하거나 저장하지 않습니다."
        }
      ]
    ],
    "android": {
      "package": "com.qet1234.tripnow",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS",
        "android.permission.POST_PROMOTED_NOTIFICATIONS"
      ]
    }
  }
}
